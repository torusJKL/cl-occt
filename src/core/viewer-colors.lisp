(in-package :cl-occt)

(defclass viewer-color ()
  ((%r :initarg :r :reader color-r)
   (%g :initarg :g :reader color-g)
   (%b :initarg :b :reader color-b)
   (%name :initarg :name :initform nil :reader color-name)))

(defun viewer-color-p (obj)
  (typep obj 'viewer-color))

(defun make-color (&key keyword rgb hls)
  (cond (keyword
         (let ((triple (named-color keyword)))
           (when triple
             (destructuring-bind (r g b) triple
               (make-instance 'viewer-color :r r :g g :b b :name keyword)))))
        (rgb
         (destructuring-bind (r g b) rgb
           (make-instance 'viewer-color :r r :g g :b b)))
        (hls
         (destructuring-bind (h l s) hls
           (multiple-value-bind (r g b) (hls-to-rgb h l s)
             (make-instance 'viewer-color :r r :g g :b b))))
        (t nil)))

(defun color-rgb (color)
  (typecase color
    (keyword (named-color color))
    (cons (and (= (length color) 3) color))
    (viewer-color (list (color-r color) (color-g color) (color-b color)))
    (string (hex-to-rgb color))
    (t nil)))

(defun normalize-color (color)
  (color-rgb color))

