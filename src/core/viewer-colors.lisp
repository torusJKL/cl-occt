(defun named-color (name)
  (cdr (assoc name *named-colors* :test #'eq)))

(defun list-named-colors ()
  (mapcar #'car *named-colors*))

(defun named-color-exists-p (name)
  (not (null (named-color name))))

;; --- Hex color parsing ---

(defun hex-to-rgb (hex)
  (when (and (stringp hex) (plusp (length hex)))
    (let* ((str (string-left-trim "#" (string-trim '(#\space #\tab #\newline) hex)))
           (len (length str)))
      (cond ((= len 6)
             (parse-hex-6 str))
            ((= len 3)
             (parse-hex-3 str))
            (t nil)))))

(defun hex-digit-char-p (c)
  (or (char<= #\0 c #\9)
      (char<= #\a c #\f)
      (char<= #\A c #\F)))

(defun parse-hex-value (str start end)
  (let ((val 0))
    (loop for i from start below end
          for c = (char str i)
          do (setf val (+ (* val 16)
                          (cond ((char<= #\0 c #\9) (- (char-code c) (char-code #\0)))
                                ((char<= #\A c #\F) (+ (- (char-code c) (char-code #\A)) 10))
                                ((char<= #\a c #\f) (+ (- (char-code c) (char-code #\a)) 10))))))
    val))

(defun parse-hex-6 (str)
  (when (and (= (length str) 6) (every #'hex-digit-char-p str))
    (list (/ (parse-hex-value str 0 2) 255.0d0)
          (/ (parse-hex-value str 2 4) 255.0d0)
          (/ (parse-hex-value str 4 6) 255.0d0))))

(defun parse-hex-3 (str)
  (when (and (= (length str) 3) (every #'hex-digit-char-p str))
    (let ((r (parse-hex-value str 0 1))
          (g (parse-hex-value str 1 2))
          (b (parse-hex-value str 2 3)))
      (list (/ (+ (* r 16) r) 255.0d0)
            (/ (+ (* g 16) g) 255.0d0)
            (/ (+ (* b 16) b) 255.0d0)))))

;; --- HLS to RGB conversion ---

(defun hls-to-rgb (h l s)
  (labels ((hue-to-rgb (v1 v2 h)
             (when (minusp h) (incf h))
             (when (> h 1) (decf h))
             (cond ((< h (/ 1 6)) (+ v1 (* (- v2 v1) h 6)))
                   ((< h 0.5) v2)
                   ((< h (/ 2 3)) (+ v1 (* (- v2 v1) (- (/ 2 3) h) 6)))
                   (t v1))))
    (if (zerop s)
        (values l l l)
        (let* ((v2 (if (< l 0.5) (* l (1+ s)) (+ l s (* l s))))
               (v1 (- (* 2 l) v2)))
          (values (hue-to-rgb v1 v2 (+ h (/ 1 3)))
                  (hue-to-rgb v1 v2 h)
                  (hue-to-rgb v1 v2 (- h (/ 1 3))))))))

;; --- Color difference (CIE76, Euclidean in RGB) ---

(defun color-delta (c1 c2)
  (let* ((rgb1 (color-rgb c1))
         (rgb2 (color-rgb c2)))
    (when (and rgb1 rgb2)
      (destructuring-bind (r1 g1 b1) rgb1
        (destructuring-bind (r2 g2 b2) rgb2
          (sqrt (+ (expt (- r1 r2) 2)
                   (expt (- g1 g2) 2)
                   (expt (- b1 b2) 2))))))))


