(asdf:defsystem :cl-occt/tests
  :description "Tests for cl-occt"
  :depends-on (:cl-occt)
  :serial t
  :pathname "t/"
  :components
  ((:file "test-helpers")
   (:file "primitives-tests")
   (:file "geom2d-tests")
   (:file "curves-tests")
   (:file "gc-tests")
   (:file "faces-tests")
   (:file "booleans-tests")
   (:file "transforms-tests")
   (:file "io-tests")
   (:file "compounds-tests")
   (:file "assembly-tests")
   (:file "viewer-tests")
   (:file "trihedron-camera-tests")
   (:file "selection-tests")
   (:file "lighting-tests")
   (:file "grid-background-rendering-tests")
   (:file "text-labels-dimensions-tests")
   (:file "drawer-tests")
   (:file "colors-tests")
   (:file "font-text-tests")
   (:file "mass-properties-tests")
   (:file "shape-analysis-topology-tests")
   (:file "operations-tests")
   (:file "features-offset-tests")
   (:file "shape-healing-tests")
   (:file "ais-types-tests")
   (:file "mesh-tests")
       (:file "xcaf-tests")
    (:file "xcaf-dimtol-tests")
    (:file "graphic3d-tests")
   (:file "animation-structure-group-tests")
   (:file "prs3d-math-inttools-tests")
   (:file "check-hlr-conversion-tests")
      (:file "topology-navigation-tests")
      (:file "bop-tests")
      (:file "brep-analysis-tests")
    (:file "faircurve-geomplate-tests")
       (:file "ocaf-core-tests")
       (:file "test-runner"))
  :perform (test-op (o c)
             (let ((*package* (find-package :cl-occt)))
               (asdf:load-system :cl-occt/tests)
               (multiple-value-bind (pass fail)
                   (funcall (find-symbol "RUN-CORE-TESTS" :cl-occt))
                  (declare (ignore pass))
                  (if (plusp fail) (uiop:quit 1))))))
